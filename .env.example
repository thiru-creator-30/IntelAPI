# --- App ---
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg://intelapi:intelapi@db:5432/intelapi
POSTGRES_USER=intelapi
POSTGRES_PASSWORD=intelapi
POSTGRES_DB=intelapi

# --- Session / Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me-please-32-bytes-hex
SESSION_COOKIE_NAME=intelapi_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=1209600
CSRF_SECRET=change-me-csrf-32-bytes-hex
GOOGLE_CLIENT_ID=

# --- Environment secret encryption (Fernet key, urlsafe-base64 32 bytes) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Outbound execution policy ---
OUTBOUND_CONNECT_TIMEOUT_SECONDS=5
OUTBOUND_READ_TIMEOUT_SECONDS=15
OUTBOUND_TOTAL_TIMEOUT_SECONDS=30
OUTBOUND_MAX_RESPONSE_BYTES=1048576
OUTBOUND_MAX_REDIRECTS=5
OUTBOUND_SPEC_MAX_BYTES=2097152
OUTBOUND_BLOCK_LOOPBACK=true
OUTBOUND_BLOCK_PRIVATE=true

# --- Campaigns / worker ---
CAMPAIGN_DEFAULT_BUDGET=200
CAMPAIGN_LEASE_SECONDS=30
CAMPAIGN_HEARTBEAT_SECONDS=10
WORKER_ID=worker-local

# --- LLM (optional) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
